---
//@ts-nocheck
import { getCaseStudies } from "@lib/api";
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import SubpageTitle from "@components/Tiny Components/SubpageTitle.astro";
import LinkButton from "@components/Buttons/LinkButton.astro";

export async function getStaticPaths() {
  const caseStudies = await getCaseStudies();

  return caseStudies.map((caseStudy) => ({
    params: { slug: caseStudy.slug },
    props: { caseStudy },
  }));
}

const { caseStudy } = Astro.props;
const { caseName, category, date, image, buttonLabel } = caseStudy.caseDetails;
---

<Layout title=`${caseName} - AskExperts` currSite="Case Studies"
  ><SubpageTitle
    eyebrow="CASE STUDIES"
    title={caseName}
    text="Our achievements reflect the close collaboration between our expert
        teams and our esteemed clientele. We cultivate a workplace that
        champions peak performance and guarantees client satisfaction."
    direction="right"
  />
  <article class="case-story-article">
    <!-- <header>
      <p>CASE STUDIES</p>
      <h1>{caseName}</h1>
      <p>
        Our achievements reflect the close collaboration between our expert
        teams and our esteemed clientele. We cultivate a workplace that
        champions peak performance and guarantees client satisfaction.
      </p>
    </header> -->

    <div class="caseDetailContainer">
      <Image
        src={image.src}
        alt={image.alt}
        width={image.width}
        height={image.height}
      />
      <div class="case-details">
        <dl>
          <div>
            <dt>Case Name</dt>
            <dd>{caseName}</dd>
          </div>
          <div>
            <dt>Category</dt>
            <dd class="category">{category}</dd>
          </div>
          <div>
            <dt>Date</dt>
            <dd class="date">{date}</dd>
          </div>
        </dl>
        <LinkButton title={buttonLabel} size="medium" color="yellow" />
      </div>
    </div>

    <section class="case-story-content">
      {
        caseStudy.sections.map((section, index) => (
          <>
            {index === 0 ? <h2>{section.title}</h2> : <h3>{section.title}</h3>}

            {Array.isArray(section.content) ? (
              <>
                {section.content.map((item) => (
                  <p>{item}</p>
                ))}
              </>
            ) : (
              <p>{section.content}</p>
            )}
            {section.highlights && (
              <ul>
                {section.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            )}
            {section.image && (
              <figure>
                <Image
                  src={section.image.src}
                  alt={section.image.alt}
                  width={section.image.width}
                  height={section.image.height}
                />
                {section.image.caption && (
                  <figcaption>{section.image.caption}</figcaption>
                )}
              </figure>
            )}
          </>
        ))
      }
    </section>
  </article>
</Layout>

<style>
  @layer components {
    .case-story-article {
      display: grid;
      grid-template-columns: subgrid;
      grid-column: full;
      > * {
        grid-column: content;
      }
    }
    .caseDetailContainer {
      img {
        position: relative;

        border-radius: var(--small-radius);
        z-index: 1;
      }
    }
    .case-details {
      position: relative;

      background: var(--color-ui-primary);
      color: var(--color-on-ui-primary);
      width: 80%;
      margin: auto;
      margin-top: calc(var(--standard-spacing) * -1);
      z-index: 2;
      display: flex;
      padding: var(--standard-spacing);
      border-radius: var(--small-radius);
      justify-content: space-between;
      dl {
        display: flex;
        gap: var(--large-spacing);
      }
    }

    .case-story-content {
      display: grid;
      grid-column: content;
      grid-template-columns: subgrid;
      > *:not(:is(figure)) {
        grid-column: narrow;
      }
    }
    figure {
      display: grid;
      grid-column: content;
      grid-template-columns: subgrid;
      position: relative;
      img {
        grid-column: content;
        grid-row: 1;
        position: relative;
      }
      &::after {
        content: "";
        position: absolute;
        display: block;
        width: 100%;
        height: 100%;
        background: linear-gradient(0, var(--color-ui-primary), #0000 25%);
      }
      figcaption {
        position: relative;
        grid-column: narrow;
        grid-row: 1;
        place-self: end left;
        z-index: 3;
        color: var(--color-on-ui-primary);
      }
    }
  }
</style>
