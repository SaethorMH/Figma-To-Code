---
import Layout from "@layouts/Layout.astro";
import Hero from "@components/Frontpage/Hero.astro";
import CircleSection from "@components/Frontpage/CircleSection.astro";
import Section from "@components/Frontpage/Section.astro";
import WTEImage from "@assets/images/WTEImage.png";
import Photo1 from "@assets/images/3imageGrid/Photo.png";
import Photo2 from "@assets/images/3imageGrid/Photo-1.png";
import Photo3 from "@assets/images/3imageGrid/Photo-2.png";
import Checkmark from "@icons/checkmark.svg";
import Phone from "@icons/phone.svg";
import Clock from "@icons/clock.svg";
import Pin from "@icons/pin.svg";
import LinkButton from "@components/Buttons/LinkButton.astro";
import { Image } from "astro:assets";
import ValuesSection from "@components/Frontpage/ValuesSection.astro";
import Slider from "@components/Frontpage/Slider.astro";
---

<Layout title="Home - AskExperts" currSite="Home">
  <Hero />

  <Section
    title="What To Expect"
    subtitle="WE'LL WORK WITH YOU"
    text="Our collaboration is built on transparency, efficiency, and measurable results. Together, we create strategies tailored to your unique needs and goals."
    theme="light"
    titleSide="end"
  >
    <div class="wteImage">
      <Image src={WTEImage} alt="What to Expect" height="395" width="634" />
    </div>

    <div class="checklist">
      <Checkmark class:list={"green inline"} />
      <p>
        Collaborate to build actionable strategies that drive sustainable growth
        and deliver tangible outcomes.
      </p><Checkmark class:list={"green"} /><p>
        Identify opportunities to optimize processes and implement impactful
        solutions with measurable results.
      </p>
    </div>
  </Section>

  <Section
    title="Financial Projections"
    subtitle="FINANCIAL TOOLS"
    text="Financial projections are essential for planning and monitoring a company’s performance. They provide insights into potential revenue, expenses, and profitability over specific periods."
    theme="muted"
  >
    <div class="fullRow"><Slider /></div>
  </Section>

  <!--  -->
  <Section
    title="More than 25 years of experiance"
    subtitle="EXPERIENCE"
    text="3000+ our clients are insured around the World"
    theme="action"
    gridCol="1fr 2fr"
  >
    <CircleSection />
  </Section>
  <ValuesSection />
  <Section
    title="Contact Us. It's Easy."
    subtitle="PROCESS"
    text="Leverage agile frameworks to provide a robust synopsis for high level overviews. Iterative approaches to corporate strategy foster collaborative."
    theme="light"
  >
    <div class="contactContainer">
      <div>
        <div class="iconContact" style="background:#ffd0004c">
          <Phone color="var(--color-yellow-500)" />
        </div>
        <p class="contactType">Call Today</p>
        <p class="contactInfo">+1 800 100 900</p>
      </div>
      <div>
        <div class="iconContact" style="background:var(--color-green-400)">
          <Clock color="var(--color-green-600)" />
        </div>
        <p class="contactType">Monday to Friday</p>
        <p class="contactInfo">9AM - 5PM</p>
      </div>
      <div>
        <div class="iconContact" style="background:var(--color-neutrals-200)">
          <Pin />
        </div>
        <p class="contactType">USA Office</p>
        <p class="contactInfo">195 Devonshire St Boston, MA 02110</p>
      </div>
    </div>

    <div class="grid2_1">
      <Image
        src={Photo1}
        alt="Lady"
        height="506"
        width="316"
        style="border-radius:var(--small-radius); grid-row: span 2 ;"
      /><Image
        src={Photo2}
        alt="Ladies 1"
        height="243"
        width="316"
        style="border-radius:var(--small-radius); "
      /><Image
        src={Photo3}
        alt="Ladies 2"
        height="243"
        width="316"
        style="border-radius:var(--small-radius); "
      />
    </div>
  </Section>
</Layout>
<style>
  .wteImage {
    position: relative;
    isolation: isolate;
    grid-row: 1 / span 2;
    &::before {
      content: "";
      height: 164px;
      width: 183px;
      position: absolute;
      left: calc(var(--large-spacing) * -1);
      top: calc(var(--standard-spacing) * -1);
      background: var(--color-green-400);
      border-radius: 0.75rem;
      border: 1px solid #ededed;
      z-index: -1;
    }
    > :global(img) {
      display: block;
      width: 100%;
      height: auto;
      border-radius: var(--small-radius);
    }
  }
  .checklist {
    grid-column: center / content-end;
  }
  .fullRow {
    grid-column: content-start / content-end;
    grid-row: 2;
  }

  .grid2_1 {
    width: 90%;
    grid-column: center / content-end;
    grid-row: 1 / span 2;
    display: grid;
    position: relative;
    isolation: isolate;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: var(--small-spacing);
    &::before {
      content: "";
      height: 164px;
      width: 307px;
      position: absolute;
      left: calc(var(--large-spacing) * -1);
      bottom: calc(var(--standard-spacing) * -1);
      background: var(--color-green-400);
      border-radius: 0.75rem;
      border: 1px solid #ededed;
      z-index: -1;
    }
  }
  .contactContainer {
    grid-column: content-start / center;
    grid-row: 2;
    display: flex;
    gap: var(--small-spacing);
    flex-direction: column;
    justify-content: space-evenly;
  }
  .contactContainer > * {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--tiny-spacing);
    .contactType {
      color: var(--color-text-muted);
    }
    .contactInfo {
      font-size: 20px;
      font-weight: 700;
    }
  }
  .iconContact {
    width: fit-content;
    grid-row: 1/3;
    place-self: center;
    padding: calc(var(--small-spacing));
    border-radius: var(--infinite-radius);
    > * {
      aspect-ratio: 1/1;
      height: var(--standard-spacing);
      width: var(--standard-spacing);
    }
  }
</style>
