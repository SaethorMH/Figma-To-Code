---
const { name } = Astro.props;
---

<button popovertarget={name}> {name} </button>
<div id={name} popover>
  <slot />
</div>
<style>
  @layer components {
    button {
      /* anchor-name: --anchor; */
      padding-block: var(--tiny-spacing);
      padding-inline: var(--standard-spacing);
      background-color: var(--color-on-ui-primary);
      color: var(--color-text);
      border-radius: var(--large-radius);
      border: none;
    }
    [popover] {
      opacity: 0;
      transform: translateY(-5rem);
      /* position: absolute;
      position-anchor: --anchor; */
      position-area: bottom span-left;
      background: var(--color-surface-secondary);
      transition: 1s allow-discrete;
      padding: var(--standard-spacing);
      border-radius: var(--small-radius);
      border: none;
      max-width: 400px;
      input[type="text"],
      input[type="email"] {
        border-radius: var(--large-radius);
        border: 1px solid var(--color-neutrals-700);
        font-size: var(--h5);
      }
    }
    [popover]:popover-open {
      opacity: 1;
      transform: translateY(0rem);
    }
    @starting-style {
      [popover]:popover-open {
        opacity: 0;
        transform: translateY(-5rem);
        transition-behavior: allow-discrete;
      }
    }
  }
</style>
