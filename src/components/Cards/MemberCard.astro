---
import { Image } from "astro:assets";
import { getTeamMembers } from "@lib/api";
import Instagram from "@icons/instagram.svg";
import Facebook from "@icons/facebook.svg";
const { id, employee } = Astro.props;
// export async function getStaticPaths() {
//   const team = await getTeamMembers();

//   return team.map((employee) => ({
//     params: { slug: employee.slug },
//     props: { employee },
//   }));

const social_icons = { instagram: Instagram, facebook: Facebook };
---

<li>
  <a class="cardContainer" href={`/team/${employee.slug}`}>
    <Image
      style={`view-transition-name: img-${employee.slug}`}
      src={employee.image.src}
      alt={employee.image.alt}
      width={employee.image.width}
      height={employee.image.height}
    />
    <h4>{employee.name}</h4>
    <p class="employeeTitle">{employee.title}</p>

    <p class="description">{employee.description}</p>
  </a>
  <div class="slContainer">
    {
      employee.social_links.map((sl) => {
        const Icon = social_icons[sl.icon];
        return <a href={sl.url}>{Icon && <Icon />}</a>;
      })
    }
  </div>
</li>

<style>
  @layer Components {
    li {
      list-style: none;
    }
    .cardContainer {
      anchor-scope: --imgAnchor;

      max-inline-size: 100%;
      min-inline-size: 200px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--small-spacing);

      img {
        border-radius: var(--small-radius);
        anchor-name: --imgAnchor;
      }
      a {
        text-decoration: none;
        color: var(--color-text);
      }

      .employeeTitle {
        background-color: var(--color-ui-primary);
        color: var(--color-on-ui-primary);
        padding-inline: calc(var(--small-spacing) + 5px);
        padding-block: var(--tiny-spacing);
        border-radius: var(--medium-radius);
        inline-size: fit-content;
        position-anchor: --imgAnchor;
        position: absolute;
        position-area: center;
        place-self: end;
        margin: var(--tiny-spacing);
      }
      .description {
        color: var(--color-text-muted);
      }
    }
    .slContainer {
      display: flex;

      place-self: center;
      > * {
        color: var(--color-text);
      }
    }
    @container card (width <=50rem) {
      .cardContainer {
        width: 100%;
        display: grid;
        margin-block-end: var(--small-spacing);
        grid-template-columns: minmax(0, 10rem) 1fr;
        align-items: start;
        justify-items: start;
        text-align: start;

        img {
          grid-row: 1 / span 3;
          inline-size: 100%;
          block-size: auto;
        }
        h4,
        .employeeTitle,
        .description {
          grid-column: 2;
          place-items: center;
        }
        .employeeTitle {
          position: relative;
          place-self: start;
          margin: 0;
          background-color: white;
          color: var(--color-ui-primary);
        }
      }
      .slContainer {
        display: none;
      }
    }

    @container cardWrapper (width <= 50rem) {
    }
  }
</style>
