---
const { service } = Astro.props;
import ArrowRight from "@icons/arrow--right.svg";
---

<article>
  <h2>{service.title}</h2>
  <p>{service.description}</p>
  <a href="#0">{service.buttonText} <ArrowRight stroke-width={2.5} /></a>
  <!-- <a> burde måske være en variant af en component -->
</article>

<style>
  @layer components {
    article {
      display: flex;
      flex-direction: column;
      background: var(--color-blue-700-transparent);
      color: var(--color-on-surface-elevated);
      border: 1px var(--color-neutrals-400) solid;
      padding: var(--standard-spacing); /* Dette burde være en token */
      border-radius: var(--small-radius); /* Dette burde være en token */
      backdrop-filter: blur(2px);
      :last-child {
        margin-top: auto;
      }
    }
    a {
      display: inline flex;
      gap: 1ch;
      color: var(--color-action);
      font-weight: bold;

      svg {
        inline-size: 16px;
      }
    }
    h2 {
      font-size: 25px;
    }
  }
</style>
