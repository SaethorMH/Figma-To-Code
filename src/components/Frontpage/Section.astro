---
const { title, text, subtitle, theme } = Astro.props;
---

<section data-theme={theme}>
  <div class="titleContainer">
    <subtitle>{subtitle}</subtitle>
    <h2>{title}</h2>
    <p>{text}</p>
  </div>

  <slot />
</section>

<style>
  @layer component {
    .titleContainer {
      display: flex;
      flex-direction: column;
      max-width: 65ch;
      subtitle {
        font-size: 10px;
        font-weight: 700;
      }
    }

    [data-theme="light"] {
      background: var(--color-surface-primary);
    }
    [data-theme="dark"] {
      background: var(--color-ui-primary);
      color: var(--color-on-ui-primary);
    }
  }
</style>
