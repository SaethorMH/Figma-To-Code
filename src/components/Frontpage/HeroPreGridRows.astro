---
import { Image } from "astro:assets";
import Services from "../Services.astro";
import CEOImage from "@assets/images/ceo.webp";
import LinkButton from "@components/Buttons/LinkButton.astro";
---

<section class="hero">
  <div class="hero-content">
    <h1>Empowering Your Business Growth</h1>
    <p>
      Discover tailored strategies and expert insights to take your business to
      the next level. Let us help you navigate challenges and achieve
      sustainable success.
    </p>
    <LinkButton title="Book a Meeting" link="#0" color="yellow" />
    <LinkButton title="Learn More" link="#0" color="black" />
  </div>
  <div class="bgContainer pattern">
    <Image src={CEOImage} alt="CEO" />
  </div>

  <Services />
</section>

<style>
  /* Styles her */
  @layer components {
    .hero {
      /* padding: 2rem; */
      grid-column: full-start / full-end;
      display: grid;
      grid-template-columns: subgrid;

      > * {
        grid-row: 1/2;
      }
      .hero-content {
        grid-column: content-start / content-end;
        z-index: 2;
        margin: auto 0 auto 0;
        color: var(--color-neutrals-100);
        max-width: 45ch;
      }
      .bgContainer {
        display: grid;
        grid-column: full-start / full-end;
        grid-template-columns: 1fr auto auto 1fr;
      }
      img {
        grid-column: 2/3;
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-view-box: inset(15% 15% 15% 25%);
      }
    }
  }
</style>
