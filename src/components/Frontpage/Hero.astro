---
import { Image } from "astro:assets";
import Services from "../Services.astro";
import CEOImage from "@assets/images/ceo.webp";
---

<section class="hero">
  <div class="hero-content">
    <h1>Empowering Your Business Growth</h1>
    <p>
      Discover tailored strategies and expert insights to take your business to
      the next level. Let us help you navigate challenges and achieve
      sustainable success.
    </p>
    <a href="#0">Book a Meeting</a>
    <a href="#0">Learn More</a>
  </div>
  <Image src={CEOImage} alt="CEO" />

  <Services />
</section>

<style>
  /* Styles her */
  @layer components {
    .hero {
      /* padding: 2rem; */
      grid-column: full-start / full-end;
      display: grid;
      grid-template-columns: subgrid;

      > * {
        grid-row: 1/2;
      }
      .hero-content {
        grid-column: content-start / content-end;
        z-index: 2;
        color: var(--color-neutrals-50);
      }
      img {
        grid-column: full-start / full-end;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }
  }
</style>
